{
  "name": "dsh-code-review-tab",
  "version": "2.7.0",
  "private": false,
  "description": "Right-sidebar code review tab: line-level diffs of git commits and of the working tree DSH just edited.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "code-review",
    "git",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laibanet/dsh-code-review-tab.git"
  },
  "homepage": "https://github.com/laibanet/dsh-code-review-tab#readme",
  "bugs": {
    "url": "https://github.com/laibanet/dsh-code-review-tab/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
